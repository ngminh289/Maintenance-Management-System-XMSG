
LUỒNG XỬ LÝ KẾT QUẢ KIỂM TRA (CHECKLIST WORKFLOW)
 18. ChecklistTemplates
CREATE TABLE ChecklistTemplates (
    TemplateID INT AUTO_INCREMENT PRIMARY KEY,
    AssetTypeID INT NOT NULL,
    TemplateName VARCHAR(100) NOT NULL,
    Description TEXT,
    FOREIGN KEY (AssetTypeID) REFERENCES AssetTypes(AssetTypeID)
);

-- 19. ChecklistResults
CREATE TABLE ChecklistResults (
    ChecklistID INT AUTO_INCREMENT PRIMARY KEY,
    AssetID VARCHAR(50) NOT NULL,
    WO_ID INT,
    CheckerID VARCHAR(50) NOT NULL,
    CheckTime DATETIME DEFAULT CURRENT_TIMESTAMP,
    OverallStatus VARCHAR(50) NOT NULL,
    EvidencePhoto VARCHAR(255),
    Notes TEXT,
    ReadingValue INT,
    FOREIGN KEY (AssetID) REFERENCES Assets(AssetID),
    FOREIGN KEY (WO_ID) REFERENCES WorkOrders(WO_ID),
    FOREIGN KEY (CheckerID) REFERENCES Employees(EmployeeID)
);

-- 20. ChecklistDetails
CREATE TABLE ChecklistDetails (
    DetailID INT AUTO_INCREMENT PRIMARY KEY,
    ChecklistID INT NOT NULL,
    QuestionText VARCHAR(255) NOT NULL,
    InputType VARCHAR(50) NOT NULL,   //Nên để enum để front-end dễ làm việc ['PassFail', 'Numeric', 'Text', 'Photo', 'Range']
    AnswerValue TEXT,
    IsOK BOOLEAN,
    FOREIGN KEY (ChecklistID) REFERENCES ChecklistResults(ChecklistID)
);


Bước 1: Thợ gửi kết quả (Submit Checklist)
Khi thợ hoàn thành việc kiểm tra trên App:
Hành động: Hệ thống ghi một dòng vào ChecklistResults.
Dữ liệu quan trọng: OverallStatus phải là một trong ba giá trị: 'OK', 'NG', hoặc 'Cảnh báo'.
Đính kèm: Lưu link ảnh bằng chứng vào EvidencePhoto (nếu có hỏng hóc).
Bước 2: Hệ thống phân loại và ra quyết định (Logic Backend)
Ngay khi lưu xong Checklist, Backend phải chạy một hàm kiểm tra OverallStatus để điều hướng công việc:
TRƯỜNG HỢP 1: OverallStatus = 'OK'
Ý nghĩa: Máy chạy tốt, không vấn đề gì.
Hành động: * Cập nhật bảng Assets: Status = 'Sẵn sàng'.
Cập nhật WorkOrders: Status = 'Đã hoàn thành'.
Kết thúc phiếu việc.
TRƯỜNG HỢP 2: OverallStatus = 'Cảnh báo' (Bảo trì dự đoán)
Ý nghĩa: Máy vẫn chạy được nhưng có tiếng kêu lạ hoặc rung nhẹ.
Hành động: * Cập nhật Assets: Status = 'Cảnh báo'.
Tự động tạo: Một WorkOrders mới loại 'Dự đoán' (Predictive) với trạng thái 'Chờ phê duyệt'.
Thông báo: Gửi tin nhắn cho Sếp: "Máy [Tên máy] có dấu hiệu bất thường, cần sếp duyệt lịch kiểm tra chuyên sâu".
TRƯỜNG HỢP 3: OverallStatus = 'NG' (Bảo trì khắc phục)
Ý nghĩa: Máy hỏng rồi, không chạy được nữa (Not Good).
Hành động: * Cập nhật Assets: Status = 'Đang hỏng'.
Khẩn cấp: Tự động tạo một WorkOrders loại 'Khắc phục' (Corrective) với trạng thái 'Chờ phê duyệt' và mức độ 'Khẩn cấp'.
Thông báo: Bắn thông báo đỏ lòm cho Sếp: "SỰ CỐ KHẨN CẤP: Máy [Tên máy] đã ngừng hoạt động!".





-- 20. ChecklistDetails
CREATE TABLE ChecklistDetails (
    DetailID INT AUTO_INCREMENT PRIMARY KEY,
    ChecklistID INT NOT NULL,
    QuestionText VARCHAR(255) NOT NULL,
    InputType VARCHAR(50) NOT NULL,   //Nên để enum để front-end dễ làm việc ['PassFail', 'Numeric', 'Text', 'Photo', 'Range']
    AnswerValue TEXT,
    IsOK BOOLEAN,
    FOREIGN KEY (ChecklistID) REFERENCES ChecklistResults(ChecklistID)
);
   InputType VARCHAR(50) NOT NULL,   //Nên để enum để front-end dễ làm việc ['PassFail', 'Numeric', 'Text', 'Photo', 'Range']


Loại Input (ENUM)
Ý nghĩa & Cách hiển thị (Front-end)
Ví dụ thực tế tại xưởng
PassFail
Hiện 2 nút: Đạt / Không đạt (Lưu vào IsOK).
Kiểm tra dây băng tải có đứt không?
Numeric
Hiện ô nhập số + Bàn phím số.
Nhập nhiệt độ lò đốt (°C).
Text
Hiện ô nhập văn bản (Ghi chú nhanh).
Mô tả tiếng kêu lạ của máy búa.
Photo
Nút bấm mở Camera để chụp ảnh bằng chứng.
Chụp vị trí rò rỉ dầu.
Range
Thanh trượt hoặc chọn trong khoảng (Min/Max).
Áp suất bình nén khí (từ 5-10 bar).
Selection
Hiện danh sách sổ xuống (Dropdown/Radio).
Chọn tình trạng dầu: Sạch / Đục / Đen.



